# RPC Configuration
RPC_URL=https://node.ghostnet.etherlink.com
CHAIN_ID=128123

# Private Key for executing transactions (should be a wallet with ETH for gas)
PRIVATE_KEY=your_private_key_here

# Contract Addresses
FACTORY_ADDRESS=0xad059404d7e1afcd19d7bef3a01f4416989a8d64

# Indexer/GraphQL API Configuration
INDEXER_URL=http://localhost:42069
GRAPHQL_ENDPOINT=http://localhost:42069/graphql

# Cronjob Configuration
CRON_SCHEDULE=*/5 * * * *
# Check every 5 minutes - adjust as needed

# Server Configuration
PORT=3001

# Logging
LOG_LEVEL=info
